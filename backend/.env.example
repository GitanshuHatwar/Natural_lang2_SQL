# Copy this file to .env and change values as needed.
# Use a read-only MySQL user. For example:
# CREATE USER 'nl2sql_ro'@'localhost' IDENTIFIED BY '<password>';
# GRANT SELECT ON <your_db>.* TO 'nl2sql_ro'@'localhost';
# information_schema only shows objects the user has privileges on.
# Start Ollama locally and pull the configured model: ollama pull qwen2.5-coder:7b

SQLITE_PATH=app.db
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_NUM_CTX=8192
METADATA_MAX_CHARS=12000
RESULT_ROW_LIMIT=1000
QUERY_TIMEOUT_SECONDS=30
EXTRACT_QUERY_TIMEOUT_SECONDS=10
EXTRACT_SAMPLE_ROWS=10000
SUMMARY_SAMPLE_ROWS=50
HISTORY_PAIRS=3
CORS_ORIGINS=http://localhost:5173
